# Copie para .env.local e preencha a chave em Supabase > Project Settings > API Keys.
# Nunca commite o .env.local nem cole chaves em chats ou issues.

# Públicas: vão para o navegador e são protegidas pelas regras de RLS.
NEXT_PUBLIC_SUPABASE_URL=https://qhkemlxytksotndoxtak.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sentry (opcional). Sem o DSN o monitoramento fica desligado.
# DSN: sentry.io > Settings > Projects > pulse-stock > Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=
# Nome do ambiente no painel (padrão: development ou production).
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Fração das requisições medidas em performance, de 0 a 1 (padrão: 0.1 em produção).
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=

# Só no build de produção, para enviar os source maps. Secreto: nunca no repo.
SENTRY_ORG=vidal-technologies
SENTRY_PROJECT=pulse-stock
SENTRY_AUTH_TOKEN=
