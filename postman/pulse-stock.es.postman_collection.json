                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Pide el correo de recuperación de contraseña",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 202 (o 429 si Supabase limita los correos)', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([202, 429]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "description": "Responde 202 haya o no una cuenta para el correo, para no revelar quién es usuario. El enlace del correo abre la pantalla de nueva contraseña de la app.\n\nAcceso: público.",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/password/forgot",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "password",
                "forgot"
              ]
            }
          }
        },
        {
          "name": "Guarda la nueva contraseña",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Solo cambia la contraseña si newPassword está completo en el entorno.",
                  "if (!pm.variables.get('newPassword')) {",
                  "  console.log('Cambio de contraseña omitido: completa newPassword en el entorno para usarlo.');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "description": "Usa la sesión abierta por el enlace de recuperación (cookie, no token) y la cierra después. Enlace vencido → 401 `recovery_expired`.\n\nAcceso: público.",
            "auth": {
              "type": "noauth"
