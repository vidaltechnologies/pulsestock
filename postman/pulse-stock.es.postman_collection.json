            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"{{newPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/password/reset",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "password",
                "reset"
              ]
            }
          }
        },
