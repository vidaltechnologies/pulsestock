              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/password/reset",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "password",
                "reset"
              ]
            }
          }
        },
