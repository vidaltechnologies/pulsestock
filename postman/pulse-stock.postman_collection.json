              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Pede o e-mail de recuperação de senha",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 202 (ou 429 se o Supabase limitar os e-mails)', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([202,429]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "description": "Responde 202 com ou sem conta para o e-mail, para não revelar quem é usuário. O link do e-mail abre a tela de nova senha do app.\n\nAcesso: público.",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/password/forgot",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "password",
                "forgot"
              ]
            }
          }
        },
        {
          "name": "Grava a nova senha",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Só troca a senha se newPassword estiver preenchido no ambiente.",
                  "if (!pm.variables.get('newPassword')) {",
                  "  console.log('Troca de senha pulada: preencha newPassword no ambiente para usar.');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "description": "Usa a sessão aberta pelo link de recuperação (cookie, não token) e a encerra em seguida. Link vencido → 401 `recovery_expired`.\n\nAcesso: público.",
            "auth": {
              "type": "noauth"
