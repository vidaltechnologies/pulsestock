{
  "info": {
    "name": "Pulse Stock API (English)",
    "description": "Pulse Stock REST API, a mini ERP for inventory and sales orders.\n\n**Getting started:** pick the *Pulse Stock (local)* environment, fill in `email` and `password` and run **Get an access token**. The token is saved and used by the other requests. The whole collection runs in the Collection Runner, in folder order.\n\n**Conventions:** success in `{ data }`; lists with `pagination`; errors in `{ error: { code, message, details? } }`. This collection sends `Accept-Language: en`, so error messages come in English. Sorting with `sort=field` or `sort=-field`. Every response has `X-Request-Id`.\n\n**Business rule:** stock is only deducted when the order is confirmed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// API error messages in English.",
          "pm.request.headers.upsert({ key: 'Accept-Language', value: 'en' });",
          "",
          "// Unique suffix for SKU and names, and a new valid CPF, on every request.",
          "pm.variables.set('runId', Date.now().toString(36).toUpperCase());",
          "const digits = Array.from({ length: 9 }, () => Math.floor(Math.random() * 10));",
          "for (const length of [9, 10]) {",
          "  const sum = digits.reduce((total, digit, i) => total + digit * (length + 1 - i), 0);",
          "  digits.push(((sum * 10) % 11) % 10);",
          "}",
          "pm.variables.set('cpf', digits.join(''));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "customerId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "userFullName",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "description": "Token for external clients and the screens' session",
      "item": [
        {
          "name": "Get an access token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "// Saves to the environment (or the collection, with no environment) for the next requests.",
                  "const store = pm.environment.name ? pm.environment : pm.collectionVariables;",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  store.set('accessToken', body.data.accessToken);",
                  "  store.set('refreshToken', body.data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "description": "Exchanges email and password for an accessToken (Supabase Auth JWT) and a refreshToken. No cookie is set. A deactivated user gets 403 `user_inactive`.\n\nAccess: public.",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "token"
              ]
            }
          }
        },
        {
          "name": "Refresh the token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "// Saves to the environment (or the collection, with no environment) for the next requests.",
                  "const store = pm.environment.name ? pm.environment : pm.collectionVariables;",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  store.set('accessToken', body.data.accessToken);",
                  "  store.set('refreshToken', body.data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "description": "Exchanges the refreshToken for a new pair. Each refreshToken works once.\n\nAccess: public.",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            }
          }
        },
        {
          "name": "Cookie login (used by the screens)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "description": "Stores the session in an httpOnly cookie. To call the API from outside the app, use `/auth/token`.\n\nAccess: public.",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Request the password recovery email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 202 (or 429 if Supabase rate-limits the emails)', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([202, 429]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "description": "Answers 202 whether or not the email has an account, so the route doesn't reveal who is a user. The email link opens the app's new password screen.\n\nAccess: public.",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/password/forgot",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "password",
                "forgot"
              ]
            }
          }
        },
        {
          "name": "Save the new password",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Only changes the password if newPassword is filled in the environment.",
                  "if (!pm.variables.get('newPassword')) {",
                  "  console.log('Password change skipped: fill in newPassword in the environment to use it.');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "description": "Uses the session opened by the recovery link (cookie, not token) and ends it afterwards. Expired link → 401 `recovery_expired`.\n\nAccess: public.",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"{{newPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/password/reset",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "password",
                "reset"
              ]
            }
          }
        },
        {
          "name": "Signed-in user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
